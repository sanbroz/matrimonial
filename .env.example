# Local Postgres from docker-compose.yml
DATABASE_URL="postgresql://matri:matri_local_pw@localhost:5433/matrimonial?schema=public"

# Long random string used to sign login cookies
AUTH_SECRET="change-me-to-a-long-random-string"

# First owner account, created by `npm run db:seed`
OWNER_NAME="Owner"
OWNER_EMAIL="owner@example.com"
OWNER_PASSWORD="change-me"

# Where uploaded photos and kundli files are stored (outside /public)
UPLOAD_DIR="./storage/uploads"
