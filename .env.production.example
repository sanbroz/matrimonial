# Copy to .env.production on the server and fill in. Never commit .env.production.
# Generate random values with:  openssl rand -hex 32

# Recommended: behind a Cloudflare Tunnel (Cloudflare does HTTPS for every bureau subdomain), see below.
# Directly on the internet, Caddy only gets certificates for the names listed here
# (e.g. "bureau.example.com, matrimonial.example.com"); new bureaus then need a line here too.
SITE_ADDRESS=bureau.example.com

# ---- Bureaus (multi-tenant) ----
# Each bureau answers on <subdomain>.PLATFORM_DOMAIN; the super admin console on
# CONSOLE_SUBDOMAIN.PLATFORM_DOMAIN. Point a wildcard DNS record (*.PLATFORM_DOMAIN) at the server/tunnel.
PLATFORM_DOMAIN=example.com
CONSOLE_SUBDOMAIN=bureau
# Subdomains that bureaus may not use (your other sites on the domain), comma separated
RESERVED_SLUGS=
# A single-bureau install is moved into this bureau on the first multi-bureau deploy
FIRST_TENANT_SLUG=matrimonial
# Super admin login (created on the first deploy; defaults to OWNER_EMAIL / OWNER_PASSWORD)
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# --- Behind a Cloudflare Tunnel instead (Cloudflare does HTTPS) ---
# SITE_ADDRESS=:80
# HTTP_BIND=127.0.0.1        # only cloudflared on this machine can reach the port
# HTTP_PORT=8090             # tunnel route: http://localhost:8090
# HTTPS_PORT=8091            # unused, kept on localhost
# CLIENT_IP_HEADER=cf-connecting-ip

# Database password (letters and digits only, e.g. openssl rand -hex 24)
POSTGRES_PASSWORD=

# Long random string that signs login cookies (openssl rand -hex 32)
AUTH_SECRET=

# First owner account, created on the first deploy. Change the password after signing in.
OWNER_NAME=Owner
OWNER_EMAIL=
OWNER_PASSWORD=

# ---- Backups ----
# Passphrase that encrypts every backup. KEEP A COPY OFF THE SERVER (password manager):
# without it, backups cannot be restored.
BACKUP_PASSPHRASE=
# Time of the nightly backup (24h, India time) and how many days to keep on the server
BACKUP_TIME=02:30
BACKUP_KEEP_DAYS=14

# Optional off-site copy to S3-compatible storage (Cloudflare R2, Backblaze B2, AWS S3...).
# Leave BACKUP_REMOTE empty to keep backups on the server only.
# Example for Cloudflare R2 (bucket "bureau-backups"):
BACKUP_REMOTE=
# BACKUP_REMOTE=offsite:bureau-backups
BACKUP_REMOTE_KEEP_DAYS=60
RCLONE_CONFIG_OFFSITE_TYPE=s3
RCLONE_CONFIG_OFFSITE_PROVIDER=Cloudflare
RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
RCLONE_CONFIG_OFFSITE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
RCLONE_CONFIG_OFFSITE_NO_CHECK_BUCKET=true
