{
  "name": "matrimonial",
  "version": "2.4.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx --env-file=.env ops/migrate-all.ts",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:seed-demo": "tsx --env-file=.env prisma/seed-demo.ts",
    "postinstall": "prisma generate && prisma generate --schema prisma/platform/schema.prisma",
    "db:generate": "prisma generate && prisma generate --schema prisma/platform/schema.prisma",
    "db:migrate-all": "tsx --env-file=.env ops/migrate-all.ts"
  },
  "dependencies": {
    "@fontsource/noto-sans-gurmukhi": "^5.3.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "html-to-image": "^1.11.13",
    "jose": "^6.2.18",
    "jspdf": "^4.2.1",
    "next": "15.5.29",
    "nodemailer": "^10.6.1",
    "papaparse": "^5.7.1",
    "pg": "^8.23.1",
    "prisma": "6.19.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true
  }
}
