// Matchmaking bureau CRM — staff-only.
// Money is stored as whole rupees (Int). Dates of birth are date-only (UTC).

generator client {
  provider      = "prisma-client-js"
  // native = your computer; debian-openssl-3.0.x = the production Docker image
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Staff & settings ─────────────────────────

enum Role {
  OWNER
  STAFF
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STAFF)
  active       Boolean  @default(true)
  /// Raised on password change/reset: older login cookies stop working.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  leadsCreated    Lead[]               @relation("LeadCreatedBy")
  leadsAssigned   Lead[]               @relation("LeadAssignedTo")
  profilesCreated Profile[]            @relation("ProfileCreatedBy")
  notes           Note[]
  followUps       FollowUp[]           @relation("FollowUpAssignedTo")
  followUpsMade   FollowUp[]           @relation("FollowUpCreatedBy")
  proposals       Proposal[]
  payments        Payment[]
  savedSearches   SavedSearch[]
  proposalEvents  ProposalEvent[]
  paymentsVoided  Payment[]            @relation("PaymentVoidedBy")
  resetTokens     PasswordResetToken[]
  messagesSent    OutboundMessage[]
}

/// "Forgot password" links. Only a hash of the token is stored.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

enum MessageChannel {
  EMAIL
  WHATSAPP
}

enum MessageStatus {
  SENT
  FAILED
}

/// Log of every email / WhatsApp message the app sent.
model OutboundMessage {
  id            String         @id @default(cuid())
  channel       MessageChannel
  /// biodata, receipt, payment_due, renewal, meeting, summary, password_reset, test
  kind          String
  to            String
  subject       String?
  body          String
  hasAttachment Boolean        @default(false)
  status        MessageStatus
  error         String?
  externalId    String?
  profileId     String?
  profile       Profile?       @relation(fields: [profileId], references: [id], onDelete: SetNull)
  createdById   String?
  createdBy     User?          @relation(fields: [createdById], references: [id])
  createdAt     DateTime       @default(now())

  @@index([profileId, createdAt])
  @@index([createdAt])
}

/// Single row (id = 1): everything the owner can customise.
model Settings {
  id                Int      @id @default(1)
  bureauName        String   @default("My Matrimonial Bureau")
  tagline           String?
  phone             String?
  whatsapp          String?
  email             String?
  address           String?
  logoPath          String?
  /// Browser-tab icon for this bureau (overrides the platform's); PNG / ICO / JPG / WebP
  favicon           Bytes?
  faviconType       String?
  profileCodePrefix String   @default("PM")
  nextProfileNumber Int      @default(1001)
  registrationFee   Int      @default(0)
  successFeeDefault Int      @default(0)
  receiptPrefix     String   @default("R")
  /// Does the bureau arrange family meetings? Off = profiles are only shared (no meeting stages)
  trackMeetings     Boolean  @default(true)
  /// Modules this bureau uses (Settings → Features); missing = on
  features          Json?
  /// The "Getting started" checklist was closed by the owner
  onboardingDone    Boolean  @default(false)
  /// Profile fields this bureau doesn't use (input names); hidden on forms, kept in the data
  hiddenFields      String[] @default([])
  /// How clients pay the bureau (sent with "Send payment details")
  paymentUpi        String?
  paymentBank       String?
  paymentQrPath     String?
  paymentNote       String?
  nextReceiptNumber Int      @default(1)
  /// Biodata look & which sections to show (used by the biodata generator).
  biodataOptions    Json?
  /// Rules for suggested matches (gotra rule, two-way check…).
  matchingOptions   Json?
  /// Outgoing email (Gmail / SMTP). The password inside is encrypted.
  emailConfig       Json?
  /// Daily summary email: on/off, time, recipients.
  summaryOptions    Json?
  /// "YYYY-MM-DD" (IST) of the last daily summary sent, so restarts don't send twice.
  lastSummaryDate   String?
  /// Editable WhatsApp / email message templates.
  messageTemplates  Json?
  /// WhatsApp library updates: auto-update on/off, hour, and the last automatic attempt.
  whatsappOptions   Json?
  updatedAt         DateTime @updatedAt
}

/// A profiles-list filter a staff member saved for reuse.
model SavedSearch {
  id        String   @id @default(cuid())
  name      String
  /// URL query string of /profiles, e.g. "gender=FEMALE&religion=Sikh"
  query     String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Customisable dropdown suggestions (religion, caste, education, ...).
model OptionItem {
  id        String @id @default(cuid())
  category  String
  value     String
  sortOrder Int    @default(0)

  @@unique([category, value])
  @@index([category, sortOrder])
}

model Plan {
  id           String       @id @default(cuid())
  name         String
  durationDays Int
  price        Int
  /// Max introductions (profiles shared) in the plan; null = unlimited.
  introLimit   Int?
  /// Overrides Settings.successFeeDefault when set.
  successFee   Int?
  description  String?
  active       Boolean      @default(true)
  /// Sample data; removed by "Delete demo data"
  isDemo       Boolean      @default(false)
  createdAt    DateTime     @default(now())
  memberships  Membership[]
}

// ───────────────────────── Leads ─────────────────────────

enum LeadSource {
  PHONE
  WHATSAPP
  WALK_IN
  REFERRAL
  SOCIAL_MEDIA
  NEWSPAPER
  WEBSITE
  EMAIL
  OTHER
}

enum LeadStatus {
  NEW
  FOLLOW_UP
  CONVERTED
  LOST
}

model Lead {
  id           String     @id @default(cuid())
  name         String
  phone        String
  altPhone     String?
  source       LeadSource @default(PHONE)
  /// Who the match is for, e.g. "Self", "Son", "Daughter", "Brother".
  forWhom      String?
  gender       Gender?
  city         String?
  details      String?
  status       LeadStatus @default(NEW)
  lostReason   String?
  assignedToId String?
  assignedTo   User?      @relation("LeadAssignedTo", fields: [assignedToId], references: [id])
  createdById  String
  createdBy    User       @relation("LeadCreatedBy", fields: [createdById], references: [id])
  profileId    String?    @unique
  profile      Profile?   @relation(fields: [profileId], references: [id], onDelete: SetNull)
  /// Sample data; removed by "Delete demo data"
  isDemo       Boolean    @default(false)
  /// The public lead form link it came in through (website, Instagram campaign…)
  leadFormId   String?
  leadForm     LeadForm?  @relation(fields: [leadFormId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  notes     Note[]
  followUps FollowUp[]

  @@index([status])
  @@index([phone])
  @@index([leadFormId])
}

// ───────────────────────── Profiles ─────────────────────────

enum Gender {
  MALE
  FEMALE
}

enum MaritalStatus {
  NEVER_MARRIED
  DIVORCED
  AWAITING_DIVORCE
  WIDOWED
  ANNULLED
}

enum ProfileStatus {
  ACTIVE
  ON_HOLD
  MATCHED
  CLOSED
}

model Profile {
  id          String        @id @default(cuid())
  /// Public identifier shown on biodata, e.g. PM1001.
  code        String        @unique
  status      ProfileStatus @default(ACTIVE)
  urgent      Boolean       @default(false)
  vip         Boolean       @default(false)
  specialCase Boolean       @default(false)

  // Basic
  fullName           String
  gender             Gender
  dob                DateTime?     @db.Date
  birthTime          String?
  birthPlace         String?
  heightCm           Int?
  weightKg           Int?
  complexion         String?
  bodyType           String?
  maritalStatus      MaritalStatus @default(NEVER_MARRIED)
  childrenCount      Int           @default(0)
  childrenLivingWith String?
  disability         String?
  diet               String?
  smoking            String?
  drinking           String?
  motherTongue       String?
  about              String?

  // Religion & horoscope
  religion         String?
  caste            String?
  subCaste         String?
  gotraSelf        String?
  gotraMother      String?
  gotraGrandmother String?
  sikhStatus       String?
  manglik          String?
  rashi            String?
  nakshatra        String?
  kundliPath       String?

  // Education & career
  education       String?
  educationDetail String?
  profession      String?
  employer        String?
  annualIncome    String?

  // Location & NRI
  city           String?
  state          String?
  country        String? @default("India")
  nativePlace    String?
  nativeDistrict String?
  visaStatus     String?
  willingAbroad  String?

  // Family (internal)
  fatherName       String?
  fatherOccupation String?
  motherName       String?
  motherOccupation String?
  brothers         Int?
  brothersMarried  Int?
  sisters          Int?
  sistersMarried   Int?
  familyType       String?
  familyValues     String?
  property         String?

  // Contact (INTERNAL ONLY — never printed on biodata)
  contactName     String?
  contactRelation String?
  phone           String?
  altPhone        String?
  email           String?
  address         String?

  // Consent
  consentGiven Boolean   @default(false)
  consentAt    DateTime?

  importedFrom String?
  /// Sample data; removed by "Delete demo data" (with everything attached to it)
  isDemo       Boolean  @default(false)
  createdById  String
  createdBy    User     @relation("ProfileCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lead          Lead?
  preference    PartnerPreference?
  photos        Photo[]
  notes         Note[]
  followUps     FollowUp[]
  proposalsSent Proposal[]         @relation("ProposalFrom")
  shortlist     Shortlist[]        @relation("ShortlistClient")
  shortlistedIn Shortlist[]        @relation("ShortlistCandidate")
  formLinks     ProfileFormLink[]
  proposalsGot  Proposal[]         @relation("ProposalTo")
  memberships   Membership[]
  payments      Payment[]
  dues          Due[]
  messages      OutboundMessage[]

  @@index([gender, status])
  @@index([religion, caste])
  @@index([phone])
  @@index([fullName])
}

model PartnerPreference {
  id              String          @id @default(cuid())
  profileId       String          @unique
  profile         Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  ageMin          Int?
  ageMax          Int?
  heightMinCm     Int?
  heightMaxCm     Int?
  religions       String[]
  castes          String[]
  excludeCastes   String[]
  casteNoBar      Boolean         @default(false)
  maritalStatuses MaritalStatus[]
  manglik         String?
  countries       String[]
  education       String?
  minIncome       String?
  diet            String?
  notes           String?
}

model Photo {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  path      String
  isPrimary Boolean  @default(false)
  onBiodata Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([profileId])
}

// ───────────────────────── Notes & follow-ups ─────────────────────────

enum NoteKind {
  CALL
  VISIT
  WHATSAPP
  OTHER
}

model Note {
  id        String   @id @default(cuid())
  kind      NoteKind @default(CALL)
  body      String
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  profileId String?
  profile   Profile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([profileId])
}

model FollowUp {
  id           String    @id @default(cuid())
  title        String
  dueAt        DateTime
  done         Boolean   @default(false)
  doneAt       DateTime?
  leadId       String?
  lead         Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  profileId    String?
  profile      Profile?  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  assignedToId String?
  assignedTo   User?     @relation("FollowUpAssignedTo", fields: [assignedToId], references: [id])
  createdById  String
  createdBy    User      @relation("FollowUpCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime  @default(now())

  @@index([done, dueAt])
  @@index([profileId])
  @@index([leadId])
}

// ───────────────────────── Matching pipeline (phase 4) ─────────────────────────

enum ProposalStatus {
  SHARED
  INTERESTED
  DECLINED
  MEETING_SCHEDULED
  MET
  MATCHED
  DROPPED
}

model Proposal {
  id            String          @id @default(cuid())
  /// The client whose family received the biodata.
  fromProfileId String
  fromProfile   Profile         @relation("ProposalFrom", fields: [fromProfileId], references: [id], onDelete: Cascade)
  /// The profile whose biodata was shared.
  toProfileId   String
  toProfile     Profile         @relation("ProposalTo", fields: [toProfileId], references: [id], onDelete: Cascade)
  status        ProposalStatus  @default(SHARED)
  declineReason String?
  meetingAt     DateTime?
  matchedAt     DateTime?
  /// Success stories: wedding date and a short note once the couple married
  marriedOn     DateTime?       @db.Date
  storyNote     String?
  notes         String?
  createdById   String
  createdBy     User            @relation(fields: [createdById], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  dues          Due[]
  events        ProposalEvent[]

  @@unique([fromProfileId, toProfileId])
  @@index([status, updatedAt])
  @@index([toProfileId])
  @@index([fromProfileId, createdAt])
}

/// Timeline of a proposal: every status change, with an optional note.
model ProposalEvent {
  id         String         @id @default(cuid())
  proposalId String
  proposal   Proposal       @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  status     ProposalStatus
  note       String?
  userId     String
  user       User           @relation(fields: [userId], references: [id])
  createdAt  DateTime       @default(now())

  @@index([proposalId, createdAt])
}

// ───────────────────────── Money (phase 5) ─────────────────────────

model Membership {
  id         String    @id @default(cuid())
  profileId  String
  profile    Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  planId     String
  plan       Plan      @relation(fields: [planId], references: [id])
  startDate  DateTime  @db.Date
  endDate    DateTime  @db.Date
  price      Int
  successFee Int?
  notes      String?
  createdAt  DateTime  @default(now())
  payments   Payment[]
  dues       Due[]

  @@index([endDate])
  @@index([profileId, startDate])
}

enum PaymentKind {
  REGISTRATION
  MEMBERSHIP
  SUCCESS_FEE
  OTHER
}

enum PaymentMode {
  CASH
  UPI
  BANK
  CHEQUE
  OTHER
}

/// A receipt. Never deleted (accounting): the owner can void it, and it survives
/// profile deletion with a snapshot of who paid.
model Payment {
  id           String      @id @default(cuid())
  receiptNo    String      @unique
  profileId    String?
  profile      Profile?    @relation(fields: [profileId], references: [id], onDelete: SetNull)
  /// Snapshot at the time of payment (kept if the profile is deleted)
  payerName    String
  profileCode  String
  kind         PaymentKind
  amount       Int
  mode         PaymentMode @default(CASH)
  reference    String?
  paidAt       DateTime    @default(now())
  membershipId String?
  membership   Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  dueId        String?
  due          Due?        @relation(fields: [dueId], references: [id], onDelete: SetNull)
  /// What it was for, printed on the receipt (e.g. "Gold 6 months membership")
  description  String
  notes        String?
  voidedAt     DateTime?
  voidReason   String?
  voidedById   String?
  voidedBy     User?       @relation("PaymentVoidedBy", fields: [voidedById], references: [id])
  createdById  String
  createdBy    User        @relation(fields: [createdById], references: [id])
  createdAt    DateTime    @default(now())

  @@index([paidAt])
  @@index([profileId])
  @@index([dueId])
}

enum DueStatus {
  OPEN
  PAID
  WAIVED
}

model Due {
  id           String      @id @default(cuid())
  profileId    String
  profile      Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  kind         PaymentKind
  /// e.g. "Registration fee", "Gold 6 months membership", "Success fee (match with PM1036)"
  label        String
  amount       Int
  status       DueStatus   @default(OPEN)
  proposalId   String?
  proposal     Proposal?   @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  membershipId String?
  membership   Membership? @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  notes        String?
  createdAt    DateTime    @default(now())
  payments     Payment[]

  @@index([status])
  @@index([profileId])
  @@index([proposalId])
}

// ───────────────────────── Share links ─────────────────────────

/// A public, expiring link showing one or more biodatas (no login). Only biodata content is shown:
/// never names, phones or addresses. `sections` / `layout` / `lang` are the choices made when sharing.
model ShareLink {
  id           String    @id @default(cuid())
  /// Random, unguessable part of the URL: /s/<token>
  token        String    @unique
  title        String?
  profileIds   String[]
  /// The family it was shared with (optional)
  forProfileId String?
  layout       String
  sections     String[]
  lang         String
  /// "none" (profile code only), "first" or "full" name on the biodatas
  nameMode     String    @default("none")
  expiresAt    DateTime
  revokedAt    DateTime?
  views        Int       @default(0)
  lastViewedAt DateTime?
  createdById  String
  createdAt    DateTime  @default(now())

  @@index([createdAt])
  @@index([forProfileId])
}

/// A link a family uses to fill in or update their own profile (no login). Expires; staff review the changes.
model ProfileFormLink {
  id              String    @id @default(cuid())
  token           String    @unique
  profileId       String
  profile         Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  expiresAt       DateTime
  revokedAt       DateTime?
  submissions     Int       @default(0)
  lastSubmittedAt DateTime?
  createdById     String
  createdAt       DateTime  @default(now())

  @@index([profileId])
}

/// A public enquiry form link for one place or campaign (website, email footer, Instagram post…).
/// Every enquiry becomes a lead tagged with the link, so each channel can be measured.
model LeadForm {
  id          String   @id @default(cuid())
  /// The public link: /join/<token>
  token       String   @unique
  name        String
  /// website | email | whatsapp | facebook | instagram | campaign | other
  channel     String
  heading     String?
  message     String?
  active      Boolean  @default(true)
  views       Int      @default(0)
  createdById String
  createdAt   DateTime @default(now())
  leads       Lead[]
}

/// Profiles a staff member picked for a family before sending them (Suggested matches → Shortlist).
model Shortlist {
  id          String   @id @default(cuid())
  clientId    String
  client      Profile  @relation("ShortlistClient", fields: [clientId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   Profile  @relation("ShortlistCandidate", fields: [candidateId], references: [id], onDelete: Cascade)
  createdById String
  createdAt   DateTime @default(now())

  @@unique([clientId, candidateId])
  @@index([candidateId])
}
